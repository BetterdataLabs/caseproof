# Local demo. Docker Compose configures its database, storage and queue.
CASEPROOF_ENVIRONMENT=development
CASEPROOF_DEV_IDENTITY=true
CASEPROOF_DEMO_MODE=true

# Set this to a Google Cloud project with Vertex AI access.
CASEPROOF_GCP_PROJECT=your-google-cloud-project
CASEPROOF_MODEL_NAME=gemini-3.8-flash
CASEPROOF_MODEL_LOCATION=global
CASEPROOF_SEARCH_PRICE_PER_QUERY=0.014
CASEPROOF_SEARCH_RESERVE_QUERIES=10
CASEPROOF_RESEARCH_BUDGET_USD=1.00

# Optional: use an existing credential file instead of .data/gcloud/application_default_credentials.json.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/credentials.json
